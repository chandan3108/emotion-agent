# Emotion Agent — Environment Variables

# Required: Groq API key for LLM inference
GROQ_API_KEY=your_groq_api_key_here

# Optional: Override the default models
MODEL_ID=openai/gpt-oss-120b
FAST_MODEL_ID=qwen/qwen3.8-27b

# Required for Discord bot (not needed for web-only)
DISCORD_TOKEN=your_discord_bot_token_here

# Frontend API URL (set in frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
